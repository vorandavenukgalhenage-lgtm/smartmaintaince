    {
        "id": "9361657fa1cfc53d",
        "type": "function",
        "z": "64254c13ecf31661",
        "name": "Filter and Aggregate",
        "func": "\n// Each incoming message payload looks like:\n// { machine_id, sensor_type, value, timestamp }\n\nconst key = msg.payload.machine_id + \":\" + msg.payload.sensor_type;\n\n// flow context = shared memory that persists between messages\nlet buffers = flow.get(\"buffers\") || {};\nlet buf = buffers[key] || [];\n\nbuf.push(msg.payload.value);\n\n// Keep only the last 5 readings.\n// Simulators publish every 2 seconds, so 5 readings = a ~10 second window.\nif (buf.length > 5) {\n    buf.shift();\n}\nbuffers[key] = buf;\nflow.set(\"buffers\", buffers);\n\n// Moving average = our simple noise filter + aggregation step\nconst sum = buf.reduce((a, b) => a + b, 0);\nconst avg = sum / buf.length;\n\nmsg.payload.raw_value = msg.payload.value;\nmsg.payload.aggregated_value = Number(avg.toFixed(2));\ndelete msg.payload.value;\n\n// Publish onward to the event-driven microservices on its own topic,\n// e.g. processed/M-001/vibration - the anomaly-detection, work-order\n// and historian services all subscribe to processed/+/+.\nmsg.topic = \"processed/\" + msg.payload.machine_id + \"/\" + msg.payload.sensor_type;\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
