# Copy this file to ".env" and edit the values before running the simulator.
# Command:  cp .env.example .env

# ----- Which machine is this simulator pretending to be? -----
# Give each running copy a different ID, e.g. M-001, M-002, M-003
MACHINE_ID=M-001

# How often to publish new readings, in milliseconds
PUBLISH_INTERVAL_MS=2000

# ----- OPTION A: Local Mosquitto broker (use this first, for testing) -----
BROKER_URL=mqtt://localhost:1883

# ----- OPTION B: AWS IoT Core (use this later, once Mosquitto works) -----
# BROKER_URL=mqtts://<your-endpoint>.iot.<your-region>.amazonaws.com:8883
# CA_PATH=./certs/AmazonRootCA1.pem
# CERT_PATH=./certs/device-certificate.pem.crt
# KEY_PATH=./certs/private.pem.key
